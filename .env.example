# Elite RP Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Development Mode
DEV_MODE=false

# Steam Configuration
# Get your key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key
STEAM_DOMAIN=localhost

# Discord Configuration
# Create an app at: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost/api/auth/discord_callback.php
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_GUILD_ID=your_guild_id
WHITELIST_ROLE_ID=your_role_id

# Discord Webhook for Applications
DISCORD_WEBHOOK_URL=your_webhook_url

# Google Sheets Integration
GOOGLE_SHEETS_METHOD=webapp
GOOGLE_SHEETS_WEBAPP_URL=your_google_script_url

# Social Links
DISCORD_INVITE_URL=https://discord.gg/your_invite
INSTAGRAM_URL=
YOUTUBE_URL=
TIKTOK_URL=
SITE_URL=http://localhost

# Admin Dashboard
ADMIN_PASSWORD=change_this_password
